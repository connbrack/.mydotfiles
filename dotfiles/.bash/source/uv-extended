DEFAULT_VENV="$HOME/.uv/.venv"
_auto_activate_venv() {
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.venv/bin/activate" ]; then
      if [ "$VIRTUAL_ENV" != "$dir/.venv" ]; then
        source "$dir/.venv/bin/activate"
      fi
      return
    fi
    dir=$(dirname "$dir")
  done
  source "$DEFAULT_VENV/bin/activate"
}

_venv_on_dir_change() {
  [ "$PWD" != "$_LAST_PWD" ] && _auto_activate_venv
  _LAST_PWD="$PWD"
}
PROMPT_COMMAND="_venv_on_dir_change;$PROMPT_COMMAND"

_auto_activate_venv
